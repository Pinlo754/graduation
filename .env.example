# Copy to .env.local (local) or set in your hosting provider (Vercel → Settings → Environment Variables).

# Public base URL, used for Open Graph links and the `guests:links` script.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# RSVP storage webhook (e.g. a Google Apps Script web app that appends rows to a Google Sheet).
# Leave empty to keep RSVP turned off — guests will see your contact links instead.
RSVP_WEBHOOK_URL=
# Shared secret sent to the webhook so random people can't write to your sheet.
RSVP_WEBHOOK_SECRET=
